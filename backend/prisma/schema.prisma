generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ORGANIZER
}

enum TicketType {
  FREE
  PAID
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String?       
  fullName     String
  role         Role          @default(CUSTOMER)
  referralCode String        @unique 
  referredById String?       @map("referred_by_id")
  referredBy   User?         @relation("UserReferral", fields: [referredById], references: [id])
  referrals    User[]        @relation("UserReferral")
  points       Point[]
  coupons      Coupon[]
  events       Event[]       @relation("OrganizerEvents")
  transactions Transaction[]
  reviews      Review[]
  accounts     Account[]     
  createdAt    DateTime      @default(now()) @map("created_at") 
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Point {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int          @default(10000)
  isUsed        Boolean      @default(false) @map("is_used")
  expiresAt     DateTime     @map("expires_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  transactionId String?      @map("transaction_id") 
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@map("points")
}

model Coupon {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountPct   Int          @default(10) @map("discount_pct")
  isUsed        Boolean      @default(false) @map("is_used")
  expiresAt     DateTime     @map("expires_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  transactionId String?      @map("transaction_id") 
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@map("coupons")
}

model Event {
  id           String        @id @default(uuid())
  organizerId  String        @map("organizer_id")
  organizer    User          @relation("OrganizerEvents", fields: [organizerId], references: [id])
  name         String
  price        Int           @default(0) 
  type         TicketType    @default(FREE)
  date         DateTime      
  location     String
  description  String
  seats        Int           @map("available_seats")
  transactions Transaction[]
  reviews      Review[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("events")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  eventId       String   @map("event_id")
  event         Event    @relation(fields: [eventId], references: [id])
  quantity      Int      @default(1)
  basePrice     Int      @map("base_price")
  discount      Int      @default(0)
  finalPrice    Int      @map("final_price")
  paymentProof  String?  @map("payment_proof")
  createdAt     DateTime @default(now()) @map("created_at")
  pointsUsed    Point[]  
  couponsUsed   Coupon[] 

  @@map("transactions")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Account {
  id                String @id @default(uuid())
  userId            String @map("user_id")
  provider          String 
  providerAccountId String @map("provider_account_id")
  
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}