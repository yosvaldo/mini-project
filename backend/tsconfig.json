{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": "./src",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "types": ["node"],
    },
    "include": ["src/**/*", "prisma/seed.ts"],
    "exclude": ["node_modules", "dist"]
}